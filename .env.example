# Configuración de API Keys para Sistema Agéntico Local
# Copia este archivo a .env y añade tus claves reales

# =============================================================================
# PROVEEDORES DE IA
# =============================================================================

# OpenAI (GPT-4, GPT-3.5, etc.)
# Obtén tu API key en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic (Claude)
# Obtén tu API key en: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# CONFIGURACIÓN DEL SISTEMA
# =============================================================================

# Entorno de ejecución (development, production)
ENVIRONMENT=development

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# N8N CONFIGURATION (opcional)
# =============================================================================

# URL de N8N si está en servidor diferente
# N8N_URL=http://localhost:5678

# Credenciales de N8N si usas autenticación
# N8N_USER=admin
# N8N_PASSWORD=your-secure-password

# =============================================================================
# CONFIGURACIÓN DE API SERVER (opcional)
# =============================================================================

# Puerto del servidor API
# API_PORT=5000

# Host del servidor API
# API_HOST=0.0.0.0

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================

# 1. NUNCA commitear este archivo con claves reales a Git
# 2. El archivo .env está en .gitignore por seguridad
# 3. Solo necesitas configurar UNA de las API keys (OpenAI o Anthropic)
# 4. Para producción, usa variables de entorno del sistema en lugar de .env
# 5. Mantén tus API keys seguras y no las compartas

# =============================================================================
# EJEMPLO DE USO
# =============================================================================

# Descomenta y configura la línea correspondiente al proveedor que uses:

# Para OpenAI:
# OPENAI_API_KEY=sk-proj-abc123...

# Para Anthropic:
# ANTHROPIC_API_KEY=sk-ant-abc123...

# =============================================================================
# SOPORTE
# =============================================================================

# Si tienes problemas con la configuración:
# - Revisa docs/SETUP.md
# - Consulta docs/GUIA_COMPLETA.md
# - Abre un issue en GitHub
